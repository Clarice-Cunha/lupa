# ============================================================
# LUPA - Modelo de variáveis de ambiente
# ============================================================
# COMO USAR:
# 1. Copie este arquivo para .env (sem o .example)
# 2. Preencha os valores reais das chaves
# 3. NUNCA commite o .env no Git (já está no .gitignore)
# ============================================================

# ----- Firecrawl.dev -----
# Serviço que extrai o conteúdo de páginas web.
# Cadastre-se em https://www.firecrawl.dev para obter a chave.
FIRECRAWL_API_KEY=sua_chave_aqui

# ----- YouTube Data API v3 -----
# Permite obter metadados de vídeos (título, canal, visualizações).
# Cadastre-se em https://console.cloud.google.com e ative a API.
YOUTUBE_API_KEY=sua_chave_aqui

# ----- OpenAI (Whisper) -----
# Usado para transcrever o áudio de vídeos em texto.
# Alternativa: instalar Whisper localmente (gratuito mas mais lento).
OPENAI_API_KEY=sua_chave_aqui

# ----- HuggingFace -----
# Plataforma de modelos de IA para análise de texto/sentimento.
# Cadastre-se em https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=sua_chave_aqui

# ----- Tavily Search API -----
# Usada para buscar notícias relacionadas quando o usuário envia um texto.
# Ajuda o Gemini a identificar desinformação com mais contexto.
# Cadastre-se em https://app.tavily.com e obtenha sua chave gratuita.
TAVILY_API_KEY=sua_chave_aqui

# ----- Google Gemini -----
# Usado para gerar o resumo de cada página analisada.
# Camada gratuita generosa. Obtenha a chave em:
#   https://aistudio.google.com/apikey
# Se não preencher, o LUPA funciona normalmente mas não gera resumos.
GEMINI_API_KEY=sua_chave_aqui

# ----- Configurações gerais do backend -----
# Em qual porta o servidor do backend vai rodar
BACKEND_PORT=8000

# ----- Frontend (Next.js) -----
# URL do backend chamada pelo frontend (multiplayer e análise).
# Em desenvolvimento deixe o padrão. Em produção coloque a URL do Render.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ambiente de execução (development | production)
ENVIRONMENT=development

# Endereço do frontend autorizado a chamar o backend (CORS)
FRONTEND_URL=http://localhost:3000

# ----- Limites de uso (rate limiting) -----
# Máximo de análises por IP por hora (proteção contra abuso)
MAX_REQUESTS_PER_HOUR=20

# Tamanho máximo de upload de vídeo (em MB)
MAX_UPLOAD_SIZE_MB=100

# ----- Painel de Moderação -----
# Senha usada pela equipe LUPA para acessar o painel /moderacao e atualizar boatos.
# Troque por um valor secreto antes de publicar em produção.
MODERACAO_CHAVE=lupa2026
